// Functions, recursion and local scope.
function add(a, b) {
    return a + b;
}

function factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

function fib(n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

let counter = 0;
function bump() {
    counter = counter + 1;
}

let result = add(10, 20);
print(result);
print(factorial(5));
print(fib(10));
bump();
bump();
print(counter);
