// Conditions, else-if chains and logical operators.
function grade(score) {
    if (score >= 90) {
        return "A";
    } else if (score >= 75) {
        return "B";
    } else if (score >= 50) {
        return "C";
    } else {
        return "F";
    }
}

let x = 10;
let y = 20;
if (x < y) {
    print("x is smaller");
} else {
    print("x is larger");
}

print(grade(95));
print(grade(80));
print(grade(55));
print(grade(10));

let age = 20;
let hasId = true;
if (age >= 18 && hasId) {
    print("Entry allowed");
}
if (!(age > 60) || false) {
    print("Not a senior");
}
