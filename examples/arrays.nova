// Arrays: literals, indexing, assignment, len and loops.
let numbers = [10, 20, 30, 40];

print(numbers[0]);
numbers[1] = 99;
print(numbers);
print(len(numbers));

function largest(arr) {
    let best = arr[0];
    for (let i = 1; i < len(arr); i = i + 1) {
        if (arr[i] > best) { best = arr[i]; }
    }
    return best;
}
print(largest(numbers));

let grid = [[1, 2], [3, 4]];
grid[1][0] = 9;
print(grid);
